# Copia este archivo como .env y completa los valores
# cp .env.example .env

GROQ_API_KEY=          # REQUERIDO — obtén tu key gratis en https://console.groq.com

# Desarrollo local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=     # Opcional en dev — Django usa un fallback inseguro si está vacío
ALLOWED_ORIGINS=http://localhost:5173

# Producción (Render) — cambiar estos valores
# DEBUG=False
# ALLOWED_HOSTS=tu-app.onrender.com
# ALLOWED_ORIGINS=https://tu-app.vercel.app
# DJANGO_SECRET_KEY=genera-una-key-segura-aqui
